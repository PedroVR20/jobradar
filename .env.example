# Portas expostas no host pelo docker-compose.yml. Copie este arquivo pra
# ".env" (não versionado) e troque os valores se alguma porta já estiver
# em uso na sua máquina (erro tipo "port is already allocated" ao rodar
# `docker compose up`).
#
#   cp .env.example .env
#
# As portas internas dos containers continuam as mesmas (5432/8080/80) —
# só a porta que você acessa no localhost muda.

POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Opcional — habilita os recursos de IA (carta de apresentação, detecção de
# duplicatas e classificação de senioridade/stack via Gemini). Sem essa
# variável, esses recursos ficam desativados e o resto do app funciona igual.
# Pegue uma key grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=
