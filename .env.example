# Portas expostas no host pelo docker-compose.yml. Copie este arquivo pra
# ".env" (não versionado) e troque os valores se alguma porta já estiver
# em uso na sua máquina (erro tipo "port is already allocated" ao rodar
# `docker compose up`).
#
#   cp .env.example .env
#
# As portas internas dos containers continuam as mesmas (5432/8080/80) —
# só a porta que você acessa no localhost muda.

POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Opcional — habilita os recursos de IA (carta de apresentação, detecção de
# duplicatas e classificação de senioridade/stack via Gemini). Sem essa
# variável, esses recursos ficam desativados e o resto do app funciona igual.
# Pegue uma key grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: várias keys separadas por vírgula, de projetos Google Cloud
# diferentes (uma key sozinha por projeto pode ficar presa na mesma cota se
# vierem do mesmo projeto). Se preenchida, tem prioridade sobre
# GEMINI_API_KEY acima e o backend troca de key sozinho quando uma bate no
# limite do free tier. Ex: GEMINI_API_KEYS=chave1,chave2,chave3
GEMINI_API_KEYS=

# Opcional — troca o modelo usado (padrão: gemini-flash-latest, um alias que
# o Google mantém sempre apontando pro modelo flash atual, evitando quebrar
# quando uma versão específica é descontinuada — já vimos "gemini-2.5-flash"
# fixo dar 404 em projetos novos por causa disso).
GEMINI_MODEL=

# Opcional — habilita o botão "🔒 Retreinar modelo de salário" em
# Configurações → Área avançada (fica escondido atrás desse código até você
# preencher). Não é segurança de verdade, é só um gate contra clique
# acidental — o app roda localhost pra uso pessoal. Escolha qualquer texto.
RETRAIN_SECRET_CODE=
