# Dados/saída do treino do modelo de salário — regeneráveis a qualquer
# momento (ver scripts/README.md); a cópia que importa de verdade é
# backend/src/main/resources/salary_model.json, essa sim é versionada.
scripts/training_data.json
scripts/salary_model.json

# Volume do modelo retreinado pelo botão "🔒 Retreinar" (SalaryModelTrainerService)
# — específico de cada máquina/deploy, não é pra versionar; sobrevive a
# "docker compose up" via bind-mount (ver docker-compose.yml).
/data/

# Fase 5.4 — dumps do backup automático/manual do Postgres (BackupService).
# Dado real do usuário, não pertence ao repositório — só o bind-mount local.
/backups/
