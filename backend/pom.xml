<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>br.com</groupId>
    <artifactId>job-radar</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>job-radar</name>

    <properties>
        <java.version>21</java.version>
        <!-- Fase 15.1 — 1.19.8 (o padrão gerenciado pelo Spring Boot 3.3.0)
             não fala corretamente com versões recentes do Docker Desktop
             (resposta 400 vazia da named pipe) — bump manual pra versão
             com esse compat corrigido. -->
        <testcontainers.version>1.20.4</testcontainers.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Fase 15.4 — observabilidade: /actuator/health (liveness/readiness
             já usados pelo healthcheck do Docker, ver docker-compose.yml) e
             /actuator/metrics (contadores/latência, sem precisar instalar
             Prometheus/Grafana pra ter visibilidade básica de produção). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Fase 5.3 — Flyway: versões gerenciadas pelo BOM do Spring Boot
             (evita fixar uma versão que fique dessincronizada). O módulo
             flyway-database-postgresql é separado desde o Flyway 10 —
             sem ele o suporte a recursos específicos do Postgres degrada. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- RSS parser para We Work Remotely -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>2.1.0</version>
        </dependency>
        <!-- Parser HTML para o Nerdin, que não tem API pública (scraping da listagem) -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.17.2</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Fase 15.1 — os 54 testes existentes usam repositório mockado
             (Mockito), nenhum exercita uma query real, um índice ou uma
             migração Flyway contra um Postgres de verdade. spring-boot-
             testcontainers dá o @ServiceConnection que substitui o
             datasource pelo container automaticamente, sem precisar
             configurar application-test.yml na mão. Versão gerenciada pelo
             BOM do spring-boot-dependencies (propriedade
             testcontainers.version), mesmo padrão do Flyway acima. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
